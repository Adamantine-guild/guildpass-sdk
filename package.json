{
  "name": "guildpass-sdk-monorepo",
  "version": "0.0.0",
  "description": "Monorepo for GuildPass SDK packages",
  "private": true,
  "packageManager": "pnpm@10.34.1",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --recursive dev",
    "build": "pnpm --recursive build",
    "test": "pnpm --recursive test",
    "test:run": "pnpm --recursive test:run",
    "lint": "pnpm --recursive lint",
    "format": "pnpm --recursive format",
    "typecheck": "pnpm --recursive typecheck"
  },
  "keywords": [],
  "author": "",
  "license": "MIT"
}
