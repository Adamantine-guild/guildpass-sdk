{
  "name": "@guildpass/react",
  "version": "0.1.0",
  "description": "Official React hooks for @guildpass/sdk",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "test": "vitest"
  },
  "keywords": [
    "web3",
    "react",
    "guildpass",
    "hooks",
    "membership",
    "access-control",
    "typescript"
  ],
  "author": "GuildPass",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Adamantine-Guild/guildpass-sdk.git"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@guildpass/sdk": "workspace:*",
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18",
    "typescript": "^5.3.3",
    "tsup": "^8.0.2",
    "vitest": "^1.3.1"
  }
}
