{
  "name": "@guildpass/react",
  "version": "0.1.0",
  "description": "Official React hooks for GuildPass SDK",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "guildpass",
    "web3",
    "react",
    "hooks"
  ],
  "author": "GuildPass",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Adamantine-Guild/guildpass-sdk.git"
  },
  "peerDependencies": {
    "react": ">=18",
    "@guildpass/sdk": ">=0.1.0"
  },
  "devDependencies": {
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "react": "^18",
    "react-dom": "^18",
    "tsup": "^8.0.2",
    "typescript": "^5.3.3",
    "vitest": "^1.3.1",
    "@testing-library/react": "^14",
    "@testing-library/react-hooks": "^8",
    "@guildpass/sdk": "workspace:*"
  }
}
